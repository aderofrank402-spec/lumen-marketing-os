# Optional local process settings. This file contains no credentials.
LMOS_ENVIRONMENT=development
# LMOS_WORKSPACE_ROOT=C:\Users\USER\Desktop\Lumen-Marketing-OS
BRAVE_SEARCH_API_KEY_1=
BRAVE_SEARCH_API_KEY_2=
BRAVE_SEARCH_API_KEY_3=

# Department 2: leave blank until Lumen Sieve is live and an authorized key exists.
# Live lookups also require LMOS_ALLOW_LUMEN_LOOKUPS=true.
LUMEN_API_BASE_URL=
LUMEN_API_KEY=
LMOS_ALLOW_LUMEN_LOOKUPS=false

# Optional paid contact research, disabled by default in config/qualification.json.
HUNTER_API_KEY=

# Department 4: generate once with a cryptographically secure 32-byte value,
# hex encode it, then back it up securely; changing it breaks old suppression lookups.
LMOS_SUPPRESSION_HMAC_KEY_HEX=
